IDD_TRAVEL_TAB DIALOGEX 0, 0, 860, 380
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Reisen"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    LTEXT           "Suchen: Name, Kategorie oder Koordinaten - mehrere Wörter müssen alle passen",IDC_STATIC,7,4,430,9
    EDITTEXT        IDC_TRAVELSEARCH,7,15,380,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Leeren",IDC_FINDAREA,391,15,46,14

    LTEXT           "Kategorien",IDC_STATIC,7,35,140,9
    CONTROL         "",IDC_CATEGORYTREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,45,140,286
    LTEXT           "",IDC_TRAVEL_RESULTINFO,152,35,285,9
    CONTROL         "",IDC_LOCATIONS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,152,45,285,286

    PUSHBUTTON      "Neu",IDC_ADDLOC,7,337,50,18
    PUSHBUTTON      "Bearbeiten",IDC_EDITLOC,61,337,56,18
    PUSHBUTTON      "Löschen",IDC_REMLOC,121,337,50,18
    LTEXT           "Eigene Orte werden in Axis gespeichert - Bearbeiten/Löschen nur für eigene Orte.",IDC_STATIC,176,337,261,18

    CONTROL         "",IDC_TRAVELMAP,"Static",SS_BITMAP | SS_CENTERIMAGE | SS_REALSIZEIMAGE,445,16,392,300
    SCROLLBAR       IDC_YSCROLL,838,16,15,300,SBS_VERT
    SCROLLBAR       IDC_XSCROLL,445,317,392,12

    LTEXT           "Karte",IDC_STATIC,445,339,22,9
    EDITTEXT        IDC_MAPPLANE,468,337,22,14,ES_CENTER | ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "+",IDC_ZOOMIN,494,336,24,16
    PUSHBUTTON      "-",IDC_ZOOMOUT,520,336,24,16
    PUSHBUTTON      "Weltkarte ...",IDC_WORLD,548,336,62,16
    CTEXT           "",IDC_COORDS,614,336,110,16,SS_NOTIFY | SS_CENTERIMAGE | SS_SUNKEN
    LTEXT           "Klick in die Karte wählt die Stelle",IDC_STATIC,728,339,125,16

    PUSHBUTTON      "Hinreisen",IDC_GO,445,356,100,18
    PUSHBUTTON      "Ziel hinschicken",IDC_SEND,549,356,100,18
    PUSHBUTTON      "Wo bin ich?",IDC_WHERE,653,356,80,18

    PUSHBUTTON      "",IDC_LOCATE,0,0,10,10,NOT WS_VISIBLE
    CONTROL         "",IDC_TRACK,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE,0,0,10,10
END

IDD_SPAWN_TAB DIALOGEX 0, 0, 860, 380
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Spawns"
FONT 9, "Segoe UI", 0, 0, 0x0
BEGIN
    GROUPBOX        "Ausgewählter NPC",IDC_STATIC,570,4,283,190
    GROUPBOX        "Am Ziel - danach den NPC im Spiel anklicken",IDC_STATIC,570,199,283,70
    GROUPBOX        "Spawnpunkt für diesen NPC",IDC_STATIC,570,274,283,70

    LTEXT           "Suchen: Name, Defname, Körper-ID oder Kategorie - mehrere Wörter müssen alle passen",IDC_STATIC,7,4,555,9
    EDITTEXT        IDC_NPCSEARCH,7,15,510,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Leeren",IDC_FINDNPC,521,15,41,14

    LTEXT           "Kategorien",IDC_STATIC,7,35,150,9
    CONTROL         "",IDC_NPCTREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,7,45,150,330
    LTEXT           "",IDC_NPC_RESULTINFO,162,35,400,9
    CONTROL         "",IDC_CREATURELIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,162,45,400,330

    CONTROL         "",IDC_NPCDISPLAY,"Static",SS_BITMAP | SS_CENTERIMAGE | SS_REALSIZEIMAGE,578,16,130,150
    CONTROL         "",IDC_FRAME_SELECT,"msctls_trackbar32",TBS_BOTH | TBS_NOTICKS | WS_TABSTOP,578,170,130,14
    LTEXT           "",IDC_NPC_DETAILS,714,16,132,84,SS_NOPREFIX
    CTEXT           "",IDC_NPC_ID,714,16,10,10,NOT WS_VISIBLE
    CTEXT           "",IDC_NPC_IDDEC,714,16,10,10,NOT WS_VISIBLE
    PUSHBUTTON      "Beschwören",IDC_SUMMON,714,104,132,20
    LTEXT           "Doppelklick oder Enter in der Liste = Beschwören. Regler: Blickrichtung.",IDC_STATIC,714,130,132,27

    PUSHBUTTON      "Entfernen",IDC_SPREMOVE,578,212,64,18
    PUSHBUTTON      "Schrumpfen",IDC_SHRINK,646,212,64,18
    PUSHBUTTON      "Versteinern",IDC_SPFREEZE,714,212,64,18
    PUSHBUTTON      "Zuhause hier",IDC_SETHOME,578,238,64,18
    PUSHBUTTON      "Heimradius",IDC_SETHOMEDIST,646,238,64,18
    EDITTEXT        IDC_HOMEDIST,714,240,30,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Felder",IDC_STATIC,748,242,40,9

    LTEXT           "Anzahl",IDC_STATIC,578,286,40,9
    EDITTEXT        IDC_AMOUNT,578,296,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "ab (Min.)",IDC_STATIC,624,286,40,9
    EDITTEXT        IDC_MIN_TIME,624,296,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "bis (Min.)",IDC_STATIC,670,286,40,9
    EDITTEXT        IDC_MAX_TIME,670,296,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Radius",IDC_STATIC,716,286,40,9
    EDITTEXT        IDC_MAX_DIST,716,296,40,14,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "1. Spawnstein platzieren",IDC_PLACE_SPAWNPOINT,578,318,130,18
    PUSHBUTTON      "2. Einstellungen übernehmen",IDC_INIT_SPAWNPOINT,714,318,132,18
END

IDD_SEARCHCRITDLG DIALOGEX 0, 0, 244, 57
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search Criteria"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    EDITTEXT        IDC_SEARCH_VALUE,69,24,115,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,187,6,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,187,23,50,14
    LTEXT           "Value",IDC_STATIC,70,13,62,9
    GROUPBOX        "Search by",IDC_STATIC,7,6,59,44,WS_TABSTOP
    CTEXT           "Use F3 for Find Next, and Shift+F3 for Find Previous",IDC_STATIC,69,40,168,8
    CONTROL         "ID",IDC_ID_SEARCH,"Button",BS_AUTORADIOBUTTON | WS_GROUP,11,15,51,10
    CONTROL         "Defname",IDC_DEF_SEARCH,"Button",BS_AUTORADIOBUTTON,11,25,51,10
    CONTROL         "Description",IDC_DESC_SEARCH,"Button",BS_AUTORADIOBUTTON,11,35,51,10
END

