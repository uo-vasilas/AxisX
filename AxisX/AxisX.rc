/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU1 MENUEX 
BEGIN
    POPUP "Settings",                       65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "General",                     ID_SETTINGS_GENERAL,MFT_STRING,MFS_ENABLED
        MENUITEM "File Paths",                  ID_SETTINGS_FILEPATHS,MFT_STRING,MFS_ENABLED
        MENUITEM "Item Tab",                    ID_SETTINGS_ITEMTAB,MFT_STRING,MFS_ENABLED
        MENUITEM "Travel Tab",                  ID_SETTINGS_TRAVELTAB,MFT_STRING,MFS_ENABLED
        MENUITEM "Spawn Tab",                   ID_SETTINGS_SPAWNTAB,MFT_STRING,MFS_ENABLED
        MENUITEM "Override MulPaths",           ID_SETTINGS_OVERRIDEPATHS,MFT_STRING,MFS_ENABLED
    END
    POPUP "Profiles",                       65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "Options",                     ID_PROFILES_OPTION,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Unload Profile",              ID_PROFILES_UNLOAD,MFT_STRING,MFS_ENABLED
        MENUITEM "Load Default Profile",        ID_PROFILES_LOADDEFAULT,MFT_STRING,MFS_ENABLED
        MENUITEM "Load Last Profile",           ID_PROFILES_LOADLASTPROFILE,MFT_STRING,MFS_ENABLED
    END
    POPUP "Help",                           65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "About Axis X",   ID_HELP_ABOUTAXISX,MFT_STRING,MFS_ENABLED
        MENUITEM "Documentation",               ID_HELP_DOCUMENTATION,MFT_STRING,MFS_ENABLED
    END
    POPUP "Exit",                           65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "Close Axis X",   ID_EXIT_CLOSEAXISX,MFT_STRING,MFS_ENABLED
    END
END

IDR_MENU2 MENU 
BEGIN
    POPUP "Tool Bar Menu"
    BEGIN
        MENUITEM "Settings",                    ID_TOOLBARMENU_SETTINGS
        MENUITEM "Profile",                     ID_TOOLBARMENU_PROFILE
        MENUITEM "Help",                        ID_TOOLBARMENU_HELP
        MENUITEM "Exit",                        ID_TOOLBARMENU_EXIT
    END
END


